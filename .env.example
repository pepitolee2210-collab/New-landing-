# ─────────────────────────────────────────────────────────────
# UsaLatinoPrime — Variables de entorno
# Copia este archivo a .env.local y ajusta los valores.
# En Vercel: Project Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Número de WhatsApp del negocio (con código de país).
# Se muestra tal cual y se limpia a solo dígitos para los enlaces wa.me.
NEXT_PUBLIC_WHATSAPP="+1 (402) 824-8171"

# Video de FALLBACK general (opcional). Cada servicio ya define su propio video
# en lib/services.ts (p. ej. /videos/visa-juvenil.mp4). Esta variable sólo se usa
# si un servicio no tuviera video. Déjala vacía si no la necesitas.
NEXT_PUBLIC_VIDEO_URL=""

# (Opcional) Imagen de portada del video (poster). Déjala vacía si no tienes.
NEXT_PUBLIC_VIDEO_POSTER=""

# (Opcional) URL pública del sitio, usada para resolver la imagen que aparece
# al compartir el link (Open Graph) y rutas absolutas. Si la dejas vacía, en
# Vercel se detecta sola desde el dominio de producción. Ej: https://tudominio.com
NEXT_PUBLIC_SITE_URL=""

# ─────────────────────────────────────────────────────────────
# Meta Pixel + Conversions API (CAPI)
# Para campañas de Meta Ads (Ventas / lead-gen) con deduplicación de eventos.
# ─────────────────────────────────────────────────────────────

# Pixel ID — público (vive en el navegador). Tiene fallback en el código,
# pero defínelo aquí para que sea explícito.
NEXT_PUBLIC_FACEBOOK_PIXEL_ID="1489091455876816"

# Token de la Conversions API — SECRETO (solo servidor). NUNCA con NEXT_PUBLIC_.
# Sin él, el CAPI hace no-op seguro y solo funciona el Pixel del navegador.
# Cómo obtenerlo: Events Manager → dataset 1489091455876816 → Settings →
# Conversions API → Generate access token.
FACEBOOK_CONVERSION_API_TOKEN=""

# Versión de Graph API (servidor, opcional). Usa una vigente.
FACEBOOK_GRAPH_API_VERSION="v23.0"

# Test Events (servidor, opcional). SOLO para QA en Events Manager → Test Events.
# Déjalo VACÍO en producción.
FACEBOOK_TEST_EVENT_CODE=""

# Variante B de consentimiento (GDPR): "1" activa el banner opt-in y bloquea el
# disparo hasta que el usuario acepte. Vacío = disparo directo (Variante A, EE.UU.).
NEXT_PUBLIC_META_REQUIRE_CONSENT=""
